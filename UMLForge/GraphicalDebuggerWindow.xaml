<Window x:Class="UMLForge.GraphicalDebuggerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UMLForge — Débogueur graphique DAP" Height="760" Width="1100" MinHeight="620" MinWidth="850" Background="#0B1220" WindowStartupLocation="CenterOwner">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#111C31" Padding="14"><StackPanel><TextBlock Text="Débogueur graphique .NET · DAP" Foreground="White" FontSize="21" FontWeight="Bold"/><TextBlock Text="Points d’arrêt · pile d’appels · variables locales · pas à pas — adaptateur netcoredbg requis" Foreground="#9CC7FF" Margin="0,4,0,0"/></StackPanel></Border>
  <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Adaptateur DAP" Foreground="#DCE8F8" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="AdapterPathBox" Grid.Column="1" Margin="4" Padding="7"/><Button Grid.Column="2" Content="Parcourir…" Click="BrowseAdapter_Click" Margin="4" Padding="10,5"/>
    <TextBlock Grid.Row="1" Text="DLL cible" Foreground="#DCE8F8" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="TargetDllBox" Grid.Row="1" Grid.Column="1" Margin="4" Padding="7"/><Button Grid.Row="1" Grid.Column="2" Content="Parcourir…" Click="BrowseDll_Click" Margin="4" Padding="10,5"/>
    <TextBlock Grid.Row="2" Text="Fichier source" Foreground="#DCE8F8" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="SourceFileBox" Grid.Row="2" Grid.Column="1" Margin="4" Padding="7"/><Button Grid.Row="2" Grid.Column="2" Content="Parcourir…" Click="BrowseSource_Click" Margin="4" Padding="10,5"/>
    <TextBlock Grid.Row="3" Text="Lignes d’arrêt" Foreground="#DCE8F8" VerticalAlignment="Center" Margin="4"/><TextBox x:Name="BreakpointLinesBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="4" Padding="7" Text="1" ToolTip="Numéros de lignes séparés par des virgules, par exemple 12,25,40"/>
   </Grid>
   <WrapPanel Grid.Row="1" Margin="0,8"><Button Content="Build Debug" Click="BuildDebug_Click" Margin="3" Padding="10,6"/><Button Content="Démarrer" Click="Start_Click" Margin="3" Padding="10,6" Background="#34D399"/><Button Content="Continuer ▶" Click="Continue_Click" Margin="3" Padding="10,6"/><Button Content="Pause ‖" Click="Pause_Click" Margin="3" Padding="10,6"/><Button Content="Pas suivant ↓" Click="Next_Click" Margin="3" Padding="10,6"/><Button Content="Entrer ↳" Click="StepIn_Click" Margin="3" Padding="10,6"/><Button Content="Sortir ↰" Click="StepOut_Click" Margin="3" Padding="10,6"/><Button Content="Pile d’appels" Click="Stack_Click" Margin="3" Padding="10,6"/><Button Content="Autos / Locals" Click="Variables_Click" Margin="3" Padding="10,6"/><Button Content="Threads" Click="Threads_Click" Margin="3" Padding="10,6"/><TextBox x:Name="WatchExpressionBox" Width="170" Margin="3" Padding="6" ToolTip="Expression à évaluer, ex. count > 0"/><Button Content="Évaluer Watch" Click="EvaluateWatch_Click" Margin="3" Padding="10,6"/><Button Content="Arrêter" Click="Stop_Click" Margin="3" Padding="10,6" Background="#F87171"/></WrapPanel>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><GroupBox Header="Événements et console du débogueur" Foreground="#9CC7FF" BorderBrush="#334155" Margin="0,0,6,0"><TextBox x:Name="OutputBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" Background="#111827" Foreground="#DCE8F8" BorderThickness="0" Padding="8"/></GroupBox><GroupBox Grid.Column="1" Header="Pile d’appels / variables" Foreground="#9CC7FF" BorderBrush="#334155" Margin="6,0,0,0"><TextBox x:Name="DetailsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Background="#111827" Foreground="#DCE8F8" BorderThickness="0" Padding="8"/></GroupBox></Grid>
   <TextBlock Grid.Row="3" Foreground="#FBBF24" TextWrapping="Wrap" Margin="4,8,4,0" Text="Points d’arrêt : 12 ou 25?count > 3. Watch/Autos, pile d’appels et threads dépendent des capacités de l’adaptateur DAP. Installer un adaptateur compatible .NET, compiler en Debug et valider sous Windows."/>
  </Grid>
 </DockPanel>
</Window>
