<Window x:Class="UMLForge.DiagramManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UMLForge — Atelier multi-diagrammes UML" Height="760" Width="1120" MinHeight="600" MinWidth="900" Background="#F4F7FC" WindowStartupLocation="CenterOwner">
 <DockPanel><Border DockPanel.Dock="Top" Background="#0A1A35" Padding="14"><DockPanel><StackPanel><TextBlock Text="Atelier multi-diagrammes UML" Foreground="White" FontSize="20" FontWeight="Bold"/><TextBlock Text="Cas d'utilisation · Séquence · Activité · Composants · Déploiement · État · Paquetages" Foreground="#9CC7FF" Margin="0,3,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Nouveau" Click="NewDiagram_Click" Padding="12,7" Margin="4"/><Button Content="Ajouter élément" Click="AddNode_Click" Padding="12,7" Margin="4"/><Button Content="Valider UML" Click="Validate_Click" Padding="12,7" Margin="4"/><Button Content="Exporter UML" Click="Export_Click" Padding="12,7" Margin="4"/><Separator Width="1" Margin="6,2" Background="#64748B"/><CheckBox x:Name="SnapToGridCheck" Content="Grille aimantée" IsChecked="True" Checked="SnapToGrid_Changed" Unchecked="SnapToGrid_Changed" Foreground="White" VerticalAlignment="Center" Margin="6,0"/><Button Content="Zoom −" Click="ZoomOut_Click" Padding="10,7" Margin="3"/><Button Content="100 %" Click="ResetZoom_Click" Padding="10,7" Margin="3"/><Button Content="Zoom +" Click="ZoomIn_Click" Padding="10,7" Margin="3"/><Button Content="Ajuster" Click="FitDiagram_Click" Padding="10,7" Margin="3"/><Button Content="Terminer" Click="Done_Click" Padding="12,7" Margin="4" Background="#60A5FA"/></StackPanel></DockPanel></Border>
 <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="White" BorderBrush="#D8E1EF" BorderThickness="1" CornerRadius="8" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="DIAGRAMMES DU PROJET" FontWeight="Bold" Foreground="#0A1A35" Margin="0,0,0,10"/><ListBox x:Name="DiagramList" DisplayMemberPath="Name" SelectionChanged="DiagramList_SelectionChanged"/></DockPanel></Border>
  <Border Grid.Column="1" Margin="10,0" Background="White" BorderBrush="#D8E1EF" BorderThickness="1" CornerRadius="8"><Canvas x:Name="DiagramSurface" Background="White" ClipToBounds="True" MouseWheel="DiagramSurface_MouseWheel" MouseDown="DiagramSurface_MouseDown" MouseMove="DiagramSurface_MouseMove" MouseUp="DiagramSurface_MouseUp"/></Border>
  <Border Grid.Column="2" Background="White" BorderBrush="#D8E1EF" BorderThickness="1" CornerRadius="8" Padding="14"><ScrollViewer><StackPanel><TextBlock Text="Inspecteur d'élément" FontSize="17" FontWeight="Bold" Foreground="#0A1A35" Margin="0,0,0,12"/><TextBlock Text="Nom du diagramme"/><TextBox x:Name="DiagramNameBox" Margin="0,4,0,10" Padding="7"/><TextBlock Text="Type UML"/><ComboBox x:Name="DiagramTypeBox" Margin="0,4,0,12" Padding="5" SelectionChanged="DiagramTypeBox_SelectionChanged"/><Separator/><TextBlock Text="Élément sélectionné" FontWeight="Bold" Margin="0,12,0,8"/><TextBlock Text="Nom"/><TextBox x:Name="NodeNameBox" Margin="0,4,0,10" Padding="7"/><TextBlock Text="Type d'élément"/><ComboBox x:Name="NodeKindBox" Margin="0,4,0,10" Padding="5"/><TextBlock Text="Lien entre éléments" FontWeight="Bold" Margin="0,10,0,6"/><TextBlock Text="Source"/><ComboBox x:Name="LinkSourceBox" Margin="0,4,0,7" DisplayMemberPath="Name"/><TextBlock Text="Cible"/><ComboBox x:Name="LinkTargetBox" Margin="0,4,0,7" DisplayMemberPath="Name"/><TextBlock Text="Type / libellé du lien"/><TextBox x:Name="LinkLabelBox" Margin="0,4,0,7" Padding="7"/><TextBlock Text="Rôle source"/><TextBox x:Name="SourceRoleBox" Margin="0,4,0,7" Padding="7"/><TextBlock Text="Rôle cible"/><TextBox x:Name="TargetRoleBox" Margin="0,4,0,7" Padding="7"/><TextBlock Text="Condition de garde du lien"/><TextBox x:Name="LinkGuardBox" Margin="0,4,0,7" Padding="7"/><CheckBox x:Name="IsNavigableCheck" Content="Lien navigable" IsChecked="True" Margin="0,0,0,8"/><Button Content="Créer le lien" Click="AddLink_Click" Padding="8"/><Separator Margin="0,10,0,8"/><TextBlock Text="Stéréotype UML"/><TextBox x:Name="StereotypeBox" Margin="0,4,0,7" Padding="7"/><TextBlock Text="Visibilité"/><ComboBox x:Name="VisibilityBox" Margin="0,4,0,7" Padding="5"/><TextBlock Text="Multiplicité"/><TextBox x:Name="MultiplicityBox" Margin="0,4,0,7" Padding="7"/><TextBlock Text="Condition de garde"/><TextBox x:Name="GuardConditionBox" Margin="0,4,0,7" Padding="7"/><TextBlock Text="Contrainte"/><TextBox x:Name="ConstraintBox" Margin="0,4,0,7" Padding="7"/><TextBlock Text="Durée / contrainte temporelle"/><TextBox x:Name="DurationBox" Margin="0,4,0,7" Padding="7"/><WrapPanel Margin="0,3,0,7"><CheckBox x:Name="IsAbstractCheck" Content="Abstrait" Margin="0,0,14,0"/><CheckBox x:Name="IsStaticCheck" Content="Statique"/></WrapPanel><TextBlock Text="Détails / signature / message"/><TextBox x:Name="NodeDetailsBox" Margin="0,4,0,10" Padding="7" Height="90" AcceptsReturn="True" TextWrapping="Wrap"/><Button Content="Appliquer" Click="Apply_Click" Padding="10"/><Button Content="Supprimer l'élément" Click="DeleteNode_Click" Margin="0,8,0,0" Padding="10"/><Button Content="Supprimer le diagramme" Click="DeleteDiagram_Click" Margin="0,8,0,0" Padding="10"/><TextBlock x:Name="InfoText" Foreground="#52627A" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></ScrollViewer></Border>
 </Grid></DockPanel></Window>