<Window x:Class="UMLForge.CodeWorkspaceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit" Title="UMLForge Studio — Environnement .NET" Height="820" Width="1380" MinHeight="650" MinWidth="1000" Background="#0B1220" WindowStartupLocation="CenterOwner">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#111C31" Padding="10"><DockPanel><StackPanel Orientation="Horizontal"><TextBlock Text="UMLForge Studio" Foreground="White" FontSize="20" FontWeight="Bold"/><TextBlock Text="  C# 14 · .NET 10" Foreground="#8FC7FF" VerticalAlignment="Center" Margin="12,4,0,0"/></StackPanel><WrapPanel HorizontalAlignment="Right"><Button Content="Nouveau projet" Click="NewProject_Click" Margin="3" Padding="10,6"/><Button Content="Ouvrir dossier" Click="OpenFolder_Click" Margin="3" Padding="10,6"/><Button Content="Enregistrer" Click="SaveFile_Click" Margin="3" Padding="10,6"/><Button Content="Restore" Click="Restore_Click" Margin="3" Padding="10,6"/><Button Content="Build" Click="Build_Click" Margin="3" Padding="10,6"/><Button Content="Tests" Click="Test_Click" Margin="3" Padding="10,6"/><Button Content="▶ Exécuter" Click="Run_Click" Margin="3" Padding="10,6" Background="#60A5FA"/><Button Content="NuGet +" Click="AddPackage_Click" Margin="3" Padding="10,6"/><Button Content="Rechercher" Click="Find_Click" Margin="3" Padding="10,6"/><Button Content="Remplacer" Click="Replace_Click" Margin="3" Padding="10,6"/><Button Content="Renommer local" Click="RenameIdentifier_Click" Margin="3" Padding="10,6"/><Button Content="Renommer sémantique" Click="SemanticRename_Click" Margin="3" Padding="10,6"/><Button Content="Analyser solution" Click="AnalyzeSolution_Click" Margin="3" Padding="10,6"/><Button Content="Définition F12" Click="GoToDefinition_Click" Margin="3" Padding="10,6"/><Button Content="Références" Click="FindReferences_Click" Margin="3" Padding="10,6"/><Button Content="Trier using" Click="SortUsings_Click" Margin="3" Padding="10,6"/><Button Content="Signature help" Click="SignatureHelp_Click" Margin="3" Padding="10,6"/><Button Content="Imports auto" Click="AutoImports_Click" Margin="3" Padding="10,6"/><Button Content="Actions de code" Click="CodeActions_Click" Margin="3" Padding="10,6"/><Button Content="Diagnostics fichier" Click="AnalyzeFile_Click" Margin="3" Padding="10,6"/><Button Content="Débogueur DAP" Click="OpenDebugger_Click" Margin="3" Padding="10,6"/><Button Content="Formater" Click="Format_Click" Margin="3" Padding="10,6"/><Button Content="Mapper UML ↔ C#" Click="MapUml_Click" Margin="3" Padding="10,6"/><Button Content="Sync UML ↔ C#" Click="SyncPreview_Click" Margin="3" Padding="10,6" Background="#34D399"/></WrapPanel></DockPanel></Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#111827" BorderBrush="#263449" BorderThickness="0,0,1,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="EXPLORATEUR" Foreground="#91A4C2" FontWeight="Bold" Margin="12"/><TreeView x:Name="ProjectTree" Background="#111827" Foreground="#E5EDF9" BorderThickness="0" SelectedItemChanged="ProjectTree_SelectedItemChanged"/></DockPanel></Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
    <Grid Grid.Row="0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="100"/></Grid.RowDefinitions><TabControl x:Name="EditorTabs" Grid.Row="0" Background="#0B1220" Foreground="#E5EDF9"><TabItem Header="Éditeur C#"><Grid><avalonEdit:TextEditor x:Name="CodeEditor" ShowLineNumbers="True" FontFamily="Consolas" FontSize="14" Padding="10" Background="#0B1220" Foreground="#DCE8F8" LineNumbersForeground="#60728F" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextChanged="CodeEditor_TextChanged" PreviewKeyDown="CodeEditor_KeyDown"/>
      <Popup x:Name="CompletionPopup" PlacementTarget="{Binding ElementName=CodeEditor}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
       <Border Background="#111C31" BorderBrush="#4B83D1" BorderThickness="1" CornerRadius="5" Padding="4" MinWidth="280" MaxWidth="480" MaxHeight="320">
        <DockPanel><TextBlock DockPanel.Dock="Bottom" Text="Entrée pour insérer · Échap pour fermer · Roslyn" Foreground="#8FC7FF" FontSize="10" Margin="5,5,5,2"/><ListBox x:Name="CompletionList" Background="#111C31" Foreground="#E5EDF9" BorderThickness="0" MaxHeight="280" MouseDoubleClick="CompletionList_MouseDoubleClick"/></DockPanel>
       </Border>
      </Popup></Grid></TabItem><TabItem Header="Aide / IntelliSense"><TextBox x:Name="IntelliSenseHelp" IsReadOnly="True" TextWrapping="Wrap" Background="#0B1220" Foreground="#DCE8F8" Padding="16" Text="Workspace Roslyn : complétion sémantique, diagnostics de compilation et renommage de symboles à l’échelle de la solution. Ctrl+Espace utilise Roslyn lorsque la solution est chargée. Signature help, imports automatiques, actions de code de base et diagnostics navigables sont disponibles ; les refactorisations ne sont pas exhaustives."/></TabItem></TabControl><Border Grid.Row="1" Background="#0E1728" BorderBrush="#263449" BorderThickness="0,1,0,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="DIAGNOSTICS DU FICHIER — sélectionnez une ligne pour naviguer" Foreground="#8FC7FF" Margin="8,4" FontSize="11"/><ListBox x:Name="FileDiagnosticsList" Background="#0E1728" Foreground="#FCA5A5" BorderThickness="0" FontFamily="Consolas" FontSize="11" SelectionChanged="FileDiagnosticsList_SelectionChanged"/></DockPanel></Border></Grid>
    <Border Grid.Row="1" Background="#111827" BorderBrush="#263449" BorderThickness="0,1,0,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="SORTIE / DIAGNOSTICS" Foreground="#91A4C2" FontWeight="Bold" Margin="10,8"/><TextBox x:Name="OutputBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#111827" Foreground="#B8CBE5" BorderThickness="0" FontFamily="Consolas" Padding="10"/></DockPanel></Border>
   </Grid>
  </Grid>
 </DockPanel>
</Window>