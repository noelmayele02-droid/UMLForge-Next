<Window x:Class="UMLForge.SynchronizationReviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UMLForge — Revue de synchronisation UML ↔ C#" Height="780" Width="1250" MinHeight="600" MinWidth="950" Background="#0B1220" WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#111C31" Padding="14">
      <DockPanel>
        <StackPanel><TextBlock Text="Revue de synchronisation UML ↔ C#" Foreground="White" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="SummaryText" Text="Aucune écriture n'est faite avant validation." Foreground="#9CC7FF" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Appliquer les choix" Click="Apply_Click" Padding="14,8" Margin="4" Background="#60A5FA"/><Button Content="Fermer" Click="Close_Click" Padding="14,8" Margin="4"/></StackPanel>
      </DockPanel>
    </Border>
    <Grid Margin="12">
      <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
      <DataGrid x:Name="PlanGrid" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" SelectionMode="Single" SelectionChanged="PlanGrid_SelectionChanged" Background="#111827" Foreground="#E5EDF9" RowBackground="#111827" AlternatingRowBackground="#172338" BorderBrush="#334155" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Fichier" Binding="{Binding RelativePath}" Width="2*" IsReadOnly="True"/>
          <DataGridTextColumn Header="État" Binding="{Binding State}" Width="1.2*" IsReadOnly="True"/>
          <DataGridComboBoxColumn Header="Décision" SelectedItemBinding="{Binding Decision, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Decisions}" Width="1.5*"/>
        </DataGrid.Columns>
      </DataGrid>
      <Grid Grid.Row="1" Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <GroupBox Header="Code actuel" Foreground="#9CC7FF" BorderBrush="#334155" Margin="0,0,6,0"><TextBox x:Name="CurrentText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" Background="#111827" Foreground="#DCE8F8" BorderThickness="0" Padding="8"/></GroupBox>
        <GroupBox Grid.Column="1" Header="Code généré proposé" Foreground="#9CC7FF" BorderBrush="#334155" Margin="6,0,0,0"><TextBox x:Name="GeneratedText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" Background="#111827" Foreground="#DCE8F8" BorderThickness="0" Padding="8"/></GroupBox>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
