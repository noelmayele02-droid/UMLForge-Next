<Window x:Class="UMLForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UMLForge — UML vers C# moderne" Height="780" Width="1280"
        MinHeight="620" MinWidth="1000" Background="#F4F7FC"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#0A1A35" Padding="16,12">
      <DockPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="UMLForge" Foreground="White" FontSize="22" FontWeight="Bold"/>
          <TextBlock Text="  UML → C# 14 / .NET 10" Foreground="#9CC7FF" FontSize="13" VerticalAlignment="Center" Margin="12,3,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Studio IDE" Click="OpenStudio_Click" Padding="12,7" Margin="4,0" Background="#A7F3D0" FontWeight="Bold"/>
          <Button Content="Diagrammes UML" Click="ManageDiagrams_Click" Padding="10,7" Margin="4,0"/>
          <Button Content="＋ Classe" Click="AddClass_Click" Padding="14,7" Margin="4,0"/>
          <Button Content="↔ Association" Click="AddRelation_Click" Padding="14,7" Margin="4,0"/>
          <Button Content="Ouvrir" Click="Open_Click" Padding="14,7" Margin="4,0"/>
          <Button Content="Enregistrer" Click="Save_Click" Padding="14,7" Margin="4,0"/>
          <Button Content="Importer C#" Click="ImportCSharp_Click" Padding="10,7" Margin="4,0"/>
          <Button Content="Exporter PlantUML" Click="ExportPlantUml_Click" Padding="10,7" Margin="4,0"/>
          <Button Content="Générer / synchroniser" Click="Generate_Click" Padding="10,7" Margin="4,0" Background="#60A5FA" FontWeight="Bold"/>
          <Button Content="Compiler" Click="Build_Click" Padding="10,7" Margin="4,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="330"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Margin="12" Background="White" BorderBrush="#D8E1EF" BorderThickness="1" CornerRadius="8">
        <Grid>
          <Canvas x:Name="DiagramCanvas" Background="White" ClipToBounds="True"
                  MouseLeftButtonDown="Canvas_MouseLeftButtonDown">
            <Canvas.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Ajouter une classe" Click="AddClass_Click"/>
              </ContextMenu>
            </Canvas.ContextMenu>
          </Canvas>
          <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12" Background="#F4F7FC" Padding="8" CornerRadius="5" IsHitTestVisible="False">
            <TextBlock Text="Astuce : glissez les classes à la souris. Cliquez sur une classe pour l'éditer." Foreground="#52627A" FontSize="11"/>
          </Border>
        </Grid>
      </Border>
      <Border Grid.Column="1" Margin="0,12,12,12" Background="White" BorderBrush="#D8E1EF" BorderThickness="1" CornerRadius="8" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Inspecteur de modèle" FontSize="18" FontWeight="Bold" Foreground="#0A1A35" Margin="0,0,0,14"/>
            <TextBlock Text="Nom du projet"/>
            <TextBox x:Name="ProjectNameBox" Text="Nouveau projet" Margin="0,4,0,12" Padding="7"/>
            <Separator Margin="0,4,0,12"/>
            <TextBlock Text="Classe sélectionnée" FontWeight="Bold" FontSize="14"/>
            <TextBlock Text="Nom" Margin="0,10,0,0"/>
            <TextBox x:Name="ClassNameBox" Margin="0,4,0,10" Padding="7" TextChanged="ClassFields_Changed"/>
            <TextBlock Text="Namespace"/>
            <TextBox x:Name="NamespaceBox" Margin="0,4,0,10" Padding="7" TextChanged="ClassFields_Changed"/>
            <TextBlock Text="Attributs — un par ligne" FontWeight="SemiBold"/>
            <TextBlock Text="Format : Nom: Type (ex. Email: string)" Foreground="#66758D" FontSize="11" Margin="0,2,0,4"/>
            <TextBox x:Name="AttributesBox" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="7" TextChanged="ClassFields_Changed"/>
            <TextBlock Text="Méthodes — une par ligne" FontWeight="SemiBold" Margin="0,12,0,0"/>
            <TextBlock Text="Format : Nom(param: Type): Retour (ex. Valider(): bool)" Foreground="#66758D" FontSize="11" Margin="0,2,0,4"/>
            <TextBox x:Name="MethodsBox" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="7" TextChanged="ClassFields_Changed"/>
            <Button Content="Appliquer les modifications" Click="Apply_Click" Margin="0,14,0,0" Padding="10"/>
            <Button Content="Supprimer la classe" Click="DeleteClass_Click" Margin="0,8,0,0" Padding="10"/>
            <TextBlock x:Name="StatusText" Text="Prêt." TextWrapping="Wrap" Foreground="#52627A" Margin="0,14,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
